DirectoryIndex index.html
Options -MultiViews

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType application/vnd.android.package-archive .apk
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|manifest\.webmanifest|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS to eliminate HTTP/HTTPS duplicate canonical issues
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Canonical redirect: eliminate /index.html duplicate of /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ / [R=301,L]

  # 3. 301 Permanent Redirects for legacy crawled paths to eliminate GSC Soft 404s
  RewriteRule ^courses/?$ /curriculum [R=301,L]
  RewriteRule ^faq/?$ /admission [R=301,L]
  RewriteRule ^privacy/?$ /about [R=301,L]

  # 4. Direct serving of pre-rendered static route HTML files for search crawlers (e.g. /curriculum -> curriculum.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-zA-Z0-9\-_]+)/?$ $1.html [L]

  RewriteRule ^index\.html$ - [L]

  # Never rewrite real files or directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite direct asset/module requests to index.html.
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|json|webmanifest|png|jpe?g|gif|svg|ico|webp|avif|txt|xml|woff2?|ttf|eot|pdf|apk)$ [NC]
  RewriteRule ^ - [L]

  # BrowserRouter SPA fallback.
  RewriteRule ^ index.html [L]
</IfModule>
